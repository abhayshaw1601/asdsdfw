# =====================================================================
# Wind Forecast Decision Portal - Environment Configuration
# =====================================================================

# FastAPI Application Settings
APP_NAME="Wind Forecast Decision Portal"
PORT=8000
ENVIRONMENT=development

# MongoDB Connection String
# Local standard: mongodb://localhost:27017/wind_portal
# Docker compose: mongodb://mongo:27017/wind_portal
MONGO_URI=mongodb://localhost:27017/wind_portal

# JWT Security & Authentication
# Replace with a strong secret in production: openssl rand -hex 32
JWT_SECRET_KEY=wind-portal-super-secret-key-2026-elexon
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Static Assets (For containerized deployment)
# STATIC_DIR=/app/static
